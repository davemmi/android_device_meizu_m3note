# MTK GNSS daemon.  The GNSS HAL (gps.mt6755.so) only talks to mnld; without
# it there is no fix.  /dev/stpgps exists only after the WMT chain
# (init.m681.connectivity.rc), so mnld follows wmt_launcher.
# Not started: mtk_agpsd (AGPS/SUPL; needs ICU 56 libicuuc, which the vendor
# namespace cannot reach) and MPED.

# GPS power/status nodes of the kernel gpsdrv class (gps.c): mnld runs as
# gps and opens status and pwrctl at start ("mnl_init: 13 (Permission
# denied)" while they were root-owned).
on boot
    chown gps gps /sys/class/gpsdrv/gps/pwrctl
    chown gps gps /sys/class/gpsdrv/gps/suspend
    chown gps gps /sys/class/gpsdrv/gps/state
    chown gps gps /sys/class/gpsdrv/gps/pwrsave
    chown gps gps /sys/class/gpsdrv/gps/status
    chown gps gps /sys/class/gpsdrv/gps/rdelay

on post-fs-data
    mkdir /data/gps_mnl 0771 gps system
    mkdir /data/mpe_mnl 0771 gps system
    mkdir /data/misc/gps 0770 gps system
    mkdir /data/agps_supl 0771 gps system

service mnld /vendor/bin/mnld
    class main
    # libmnl.so destroys a mutex twice; bionic would abort (shims/mnld_mutex_n.c)
    setenv LD_PRELOAD /vendor/lib/libm3note_n_mnld.so
    user gps
    group gps inet misc sdcard_rw sdcard_r media_rw system radio
    socket mnld stream 660 gps system
    disabled

on property:init.svc.wmt_launcher=running && property:ro.vendor.meizu.profile_ready=1
    start mnld

on property:init.svc.wmt_launcher=stopped
    stop mnld

# Navigation messages crash the N GNSS HAL (NULL legacy callback in the AOSP
# gnss@1.0-impl) and mnld (get_gnss_navigation_event) as soon as an app such
# as GPS Test listens for them; the preload hides that extension
# (shims/gnss_navmsg_n.c).  Same definition as
# android.hardware.gnss@1.0-service.rc plus the preload; this file sorts after
# it in /vendor/etc/init.
service vendor.gnss_service /vendor/bin/hw/android.hardware.gnss@1.0-service
    override
    interface android.hardware.gnss@1.0::IGnss default
    class hal
    user gps
    group system gps radio
    setenv LD_PRELOAD /vendor/lib64/libm3note_gnss_navmsg.so
